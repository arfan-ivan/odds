# Isi semua ini di Vercel -> Project -> Settings -> Environment Variables
# (JANGAN commit file .env asli ke GitHub)

MQTT_BROKER=928bb5b7d5b245b7ae4ce136dc9a669e.s1.eu.hivemq.cloud
MQTT_USERNAME=isi_username_hivemq
MQTT_PASSWORD=isi_password_hivemq
MQTT_TOPIC_REALTIME=odds/sensor/realtime

# Kata sandi bebas buatan Anda, dipakai untuk melindungi /api/collect
CRON_SECRET=ganti_dengan_random_panjang

# Isi seluruh isi file JSON service account Firebase dalam SATU baris
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Opsional
COLLECT_SECONDS=50
SAVE_INTERVAL_SECONDS=30
